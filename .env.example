# ============================================
# Test Data Generator - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=testdatagen
MYSQL_USER=testdatagen
MYSQL_PASSWORD=123456

# --- Demo Database ---
# init.sql will auto-create 'demo_db' with sample tables for testing.
# After deployment, add a connection in the app:
#   Host: mysql (container name) or <ECS-IP> (external)
#   Port: 3306
#   Database: demo_db
#   User: testdatagen
#   Password: (same as MYSQL_PASSWORD above)

# --- LLM API Keys ---
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/
MIMO_API_KEY=<your-mimo-api-key>

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# --- Knowledge Base (optional) ---
KB_ENABLED=false
KB_BASE_URL=http://localhost:9090
KB_API_KEY=

# --- Security ---
# 32-hex-char key, generate with: openssl rand -hex 16
ENCRYPTION_KEY=<your-encryption-key>

# --- JVM Options ---
JAVA_OPTS=-Xms256m -Xmx512m
