# ============================================
# Test Data Generator - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=testdatagen
MYSQL_USER=testdatagen
MYSQL_PASSWORD=your_db_password_here

# --- LLM API Keys ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/
MIMO_API_KEY=your_mimo_api_key

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key

# --- Knowledge Base (optional) ---
KB_ENABLED=false
KB_BASE_URL=http://localhost:9090
KB_API_KEY=

# --- Security ---
ENCRYPTION_KEY=your_random_32_char_secret_key_here

# --- JVM Options ---
JAVA_OPTS=-Xms256m -Xmx512m
